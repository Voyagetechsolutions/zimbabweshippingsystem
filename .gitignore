.Trashes

# Temporary files
*.tmp
*.temp
tmp/
.cache
.vercel
.env*.local

# Puppeteer profile used by the store-screenshot capture script (holds a live session)
scripts/store-screenshots/.cache/

# Build artifacts: GitHub rejects files over 100 MB, and two 117 MB APKs
# here once blocked every push. Keep them on disk, out of the repo.
deliverables/*.apk
deliverables/*.aab
deliverables/*.ipa

# Google Play service-account key used by `eas submit`. A private credential
# with publish rights to the Play account: never commit it.
google-service-account.json
**/google-service-account.json
*-service-account*.json
